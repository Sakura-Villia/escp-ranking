{
  "buildCommand": "npx next build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "installCommand": "npx pnpm install",
  "regions": ["hnd1"],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
